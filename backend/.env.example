# 本地开发默认用 SQLite，零依赖即可跑通；生产/演示切 PostgreSQL（见 deploy/docker-compose.yml）
# DATABASE_URL=postgresql+psycopg://asset:asset@localhost:5432/asset
DATABASE_URL=sqlite:///./data/asset.db

JWT_SECRET=change-me-in-production
TOKEN_EXPIRE_MINUTES=720

# 二维码/邮件里指向的前端地址
FRONTEND_URL=http://localhost:5173

# 每日到期提醒（普通用户：站内信 + 邮件；管理员：站内信汇总）
REMINDER_ENABLED=true
REMINDER_HOUR=9

# SMTP 留空则不真发邮件，只记日志（演示环境友好）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
